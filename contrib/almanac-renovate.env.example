# For almanac-renovate. Keep this file readable by its user only.
DATABASE_URL=postgres://almanac@127.0.0.1/almanac
ALMANAC_OWNER=your-account
# Renovate's login. Pull requests by anyone else are left alone.
ALMANAC_RENOVATE_AUTHOR=renovate[bot]
# Your App's login, so Almanac can recognise its own echoes.
ALMANAC_BOT_LOGIN=your-app[bot]
# Where budget alerts are filed.
ALMANAC_ALERTS_REPO=your-account/your-repo
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=123456
GITHUB_APP_PRIVATE_KEY=the private key, as one value
ANTHROPIC_API_KEY=your-key
# Uncomment only when you are ready for effects to reach GitHub.
# ALMANAC_MODE=live
