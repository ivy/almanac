#!/usr/bin/env bash
# Invoking this script explicitly trusts the assigned, reviewed checkout's mise config.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  printf 'Usage: almanac-bootstrap REVIEWED_CHECKOUT [COMMAND [ARG...]]\n' >&2
  exit 2
fi
cd -- "$1"
shift
test -f mise.toml
test -f mise.lock

# These directories must belong to the workspace user, never /root or the image cache.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
mkdir -p "$CARGO_HOME" "$RUSTUP_HOME"
test -w "$CARGO_HOME"
test -w "$RUSTUP_HOME"

mise --version
mise trust "$PWD/mise.toml"
mise install --locked
mise exec -- rustup component add rustfmt clippy
mise exec -- rustc --version
mise exec -- cargo --version

if [[ $# -eq 0 ]]; then
  set -- make check
fi
exec mise exec -- "$@"
