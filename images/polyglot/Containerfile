# What a Fixer builds in for most repositories. A sandbox has no network, so anything a build needs
# must be here or in the dependency cache uploaded with the checkout.
FROM docker.io/library/node:24-bookworm AS node
FROM docker.io/oven/bun:1 AS bun

FROM docker.io/library/golang:1-bookworm
# Shared, because a sandbox runs as an unprivileged user.
ENV COREPACK_HOME=/usr/local/share/corepack
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
 && corepack enable pnpm \
 && corepack prepare pnpm@latest --activate \
 && chmod -R a+rX /usr/local/share/corepack
